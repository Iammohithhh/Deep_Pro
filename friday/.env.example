# ============================================================
# FRIDAY AI ASSISTANT - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── Claude API (optional - for advanced queries) ───────────
# Get your key at: https://console.anthropic.com
# Without this, Friday uses Ollama locally (fully free)
ANTHROPIC_API_KEY=your_key_here

# ─── Override config values via environment ─────────────────
# FRIDAY_PRIMARY_BRAIN=ollama        # ollama | claude | auto
# FRIDAY_MODEL=mistral               # Ollama model to use
# FRIDAY_PERSONALITY=professional    # professional | casual | friendly
# FRIDAY_HUD_ENABLED=true
